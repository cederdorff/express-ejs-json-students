<!doctype html>
<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Redigér studerende</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <header class="site-header">
      <nav class="site-nav" aria-label="Main navigation">
        <span class="nav-link">Studerende</span>
      </nav>
    </header>

    <main class="app">
      <h1 class="page-title">Redigér <%= student.name %></h1>

      <section>
        <form class="post-form" method="POST" action="/students/<%= student.id %>/edit">
          <div class="form-grid">
            <div class="form-field">
              <label for="name">Navn</label>
              <input id="name" name="name" type="text" value="<%= student.name %>" placeholder="Fx. Anna Jensen" />
            </div>

            <div class="form-field">
              <label for="education">Uddannelse</label>
              <input id="education" name="education" type="text" value="<%= student.education %>" placeholder="Fx. Datamatiker" />
            </div>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary">Gem ændring</button>
          </div>
        </form>
      </section>

      <a class="btn back-link" href="/">Tilbage</a>
    </main>
  </body>
</html>
