<!doctype html>
<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Redigér studerende</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <div class="container">
      <h1>Redigér <%= student.name %></h1>

      <section>
        <form method="POST" action="/students/<%= student.id %>/edit">
          <label>Navn
            <input name="name" type="text" value="<%= student.name %>" />
          </label>

          <label>Uddannelse
            <input name="education" type="text" value="<%= student.education %>" />
          </label>

          <button type="submit" class="btn btn-primary btn-submit">Gem ændring</button>
        </form>
      </section>

      <a class="btn back-link" href="/">Tilbage</a>
    </div>
  </body>
</html>
